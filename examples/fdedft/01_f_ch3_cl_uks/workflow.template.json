{
  "schema_version": 1,
  "abacus_command": ["/absolute/path/to/abacus"],
  "postprocess_command": ["/absolute/path/to/abacus"],
  "run_postprocess": true,
  "work_directory": "work",
  "fragments": [
    {"label": "F", "neutral_valence_electrons": 7, "atom_indices": [0]},
    {"label": "CH3Cl", "neutral_valence_electrons": 14, "atom_indices": [1, 2, 3, 4, 5]}
  ],
  "states": [
    {
      "label": "reactant", "total_charge": -1, "total_spin": 0,
      "fragments": {"F": {"charge": -1, "spin": 0}, "CH3Cl": {"charge": 0, "spin": 0}}
    },
    {
      "label": "product", "total_charge": -1, "total_spin": 0,
      "fragments": {"F": {"charge": 0, "spin": 1}, "CH3Cl": {"charge": -1, "spin": -1}}
    }
  ],
  "controls": {
    "execution_mode": "persistent_session",
    "spin_mode": "uks",
    "fragment_xc": "pbe",
    "embedding_xc": "pbe",
    "coupling_provider": "symmetric_linearized",
    "transition_density_trace_tolerance": 1e-8,
    "kedf": "pw91k",
    "device": "cpu",
    "ks_solver": "genelpa",
    "kpar": 1,
    "allow_partial_scf": true,
    "maximum_scf_iterations": 200,
    "scf_density_tolerance": 3e-6,
    "electron_tolerance": 1e-8,
    "mixing_type": "broyden",
    "mixing_beta": 0.1,
    "mixing_beta_mag": 0.1,
    "mixing_ndim": 8,
    "adaptive_scf": {
      "enabled": true,
      "force_strict_cycle": 45,
      "auto_tune": {
        "enabled": true,
        "stagnation_ratio": 0.9,
        "stagnation_cycles": 2,
        "iteration_pressure_fraction": 0.8,
        "promote_on_recovery": true
      },
      "stages": [
        {
          "name": "loose",
          "minimum_density_rms": 0.001,
          "maximum_iterations": 25,
          "density_tolerance": 0.0001,
          "strict": false
        },
        {
          "name": "medium",
          "minimum_density_rms": 0.00001,
          "maximum_iterations": 60,
          "density_tolerance": 0.00001,
          "strict": false,
          "mixing": {"mixing_ndim": 12}
        },
        {
          "name": "strict",
          "minimum_density_rms": 0.0,
          "maximum_iterations": 200,
          "density_tolerance": 3e-6,
          "strict": true
        }
      ]
    },
    "mixing_recovery": {
      "enabled": true,
      "fallbacks": [
        {
          "mixing_type": "pulay",
          "mixing_beta": 0.05,
          "mixing_beta_mag": 0.05,
          "mixing_ndim": 8
        },
        {
          "mixing_type": "plain",
          "mixing_beta": 0.03,
          "mixing_beta_mag": 0.03
        }
      ]
    },
    "fragment_mixing": {
      "F": {
        "mixing_type": "broyden",
        "mixing_beta": 0.1,
        "mixing_beta_mag": 0.1,
        "mixing_ndim": 8
      },
      "CH3Cl": {
        "mixing_type": "broyden",
        "mixing_beta": 0.1,
        "mixing_beta_mag": 0.05,
        "mixing_ndim": 12
      }
    },
    "maximum_freeze_thaw_cycles": 50,
    "strict_confirmation_cycles": 2,
    "freeze_thaw_density_tolerance": 1e-5,
    "energy_tolerance_ry": 2e-5,
    "update_scheme": "auto",
    "jacobi_parallelism": 1,
    "outer_mixing": {
      "type": "none",
      "beta": 0.5,
      "history": 4,
      "regularization": 1e-10,
      "apply_in_strict": false
    },
    "retain_completed_cycles": 1,
    "remove_abacus_restart_files": true,
    "update_order": ["F", "CH3Cl"],
    "singular_value_tolerance": 1e-10,
    "overlap_eigenvalue_cutoff": 1e-9,
    "symmetry_tolerance": 1e-10,
    "residual_tolerance": 1e-8
  },
  "geometries": []
}
